<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.orbit</groupId>
    <artifactId>orbit-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>orbit-academic</artifactId>
  <name>orbit-academic</name>
  <description>教务基础服务：主数据 CRUD、认证、用户、组织（35 个接口 / 10 张表）</description>

  <dependencies>
    <dependency>
      <groupId>com.orbit</groupId>
      <artifactId>orbit-common</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-redis</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>

    <!-- 数据访问：条件 UPDATE 需拿受影响行数，所以用 MyBatis 系而非 JPA -->
    <dependency>
      <groupId>com.baomidou</groupId>
      <artifactId>mybatis-plus-spring-boot4-starter</artifactId>
      <version>${mybatis-plus.version}</version>
    </dependency>
    <!--
      ⚠ 分页拦截器 PaginationInnerInterceptor 在 MyBatis-Plus 3.5.9+ 被**拆到了独立构件**：
      它依赖 jsqlparser（用来改写 SQL 加 LIMIT），而 jsqlparser 的大版本各有兼容问题，
      所以官方不再随 extension 一起发，改为让使用者显式选择。

      不引它的后果是**静默的**：selectPage() 不报错，只是**不做分页**（没有 LIMIT）、
      total 也拿不到 —— 看起来像「分页参数没生效」。
      所以必须引这个构件，并且在 P1 里**实测** ?size=1 只返回 1 条。
    -->
    <dependency>
      <groupId>com.baomidou</groupId>
      <artifactId>mybatis-plus-jsqlparser</artifactId>
      <version>${mybatis-plus.version}</version>
    </dependency>
    <dependency>
      <groupId>com.mysql</groupId>
      <artifactId>mysql-connector-j</artifactId>
      <scope>runtime</scope>
    </dependency>
    <!--
      Schema 迁移：替代原 create_all + 手写 ALTER；每个服务独立 history 表。

      ⚠ Spring Boot 4 起自动配置被拆成独立模块（spring-boot-jdbc / spring-boot-webmvc /
        spring-boot-security / spring-boot-data-redis …）。flyway 的自动配置**不在**
        spring-boot-autoconfigure 里，所以只声明 flyway-core 会「静默失效」：
        不报错、不建表、也不建 history 表 —— 启动一切正常，只是迁移从来没跑过。
        必须走 starter，它才会带进 spring-boot-flyway 模块。
        这个坑只有真的连库跑起来才会发现。
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-flyway</artifactId>
    </dependency>
    <!-- Flyway 10+ 起数据库方言拆成独立模块，MySQL 要单独引 -->
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-mysql</artifactId>
    </dependency>

    <!-- JWT 依赖由 orbit-common 提供（JwtService 在里面，两个服务都要校验 token） -->

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>mysql</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
