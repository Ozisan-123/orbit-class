<?xml version="1.0" encoding="UTF-8"?>
<!--
  智能教务中台 · 多模块父工程

  ⚠ 版本说明：下方 <properties> 中的版本号取自官方文档与 Maven Central 的公开信息，
     但本工程尚未用 Maven 编译验证过（开发机上未安装 Maven）。
     首次构建前请按官方 compatibility matrix 核对：
       - Spring Boot 4.1.1 要求 Java 17+（本工程用 21 LTS）
       - Spring Cloud 必须与 Spring Boot 严格对应，不可自行搭配
       - Spring AI / MyBatis-Plus / Resilience4j 的坐标在各版本间有过调整
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.orbit</groupId>
  <artifactId>orbit-parent</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>orbit-parent</name>
  <description>智能教务中台（多租户排课 SaaS）</description>

  <modules>
    <module>orbit-common</module>
    <module>orbit-solver-core</module>
    <module>orbit-academic</module>
    <module>orbit-scheduling</module>
    <module>orbit-solver-worker</module>
    <module>orbit-gateway</module>
    <module>orbit-assistant</module>
  </modules>

  <properties>
    <java.version>21</java.version>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

    <!-- 待核实：见文件头说明 -->
    <spring-boot.version>4.1.1</spring-boot.version>
    <!--
      ⚠ Spring Cloud 与 Spring Boot 必须成对，且**只在启动时才校验**：
      2025.1.1 会在运行时被 Spring Cloud 的 compatibility verifier 拒绝
      （"Spring Boot [4.1.1] is not compatible with this Spring Cloud release train,
        change Spring Boot to 4.0.x"）。Maven 解析 BOM 时一切正常，
      所以「BOM 能解析」不等于「版本兼容」—— 必须真的把服务跑起来才算验证过。
    -->
    <spring-cloud.version>2025.1.3</spring-cloud.version>
    <spring-ai.version>2.0.0</spring-ai.version>
    <mybatis-plus.version>3.5.17</mybatis-plus.version>
    <resilience4j.version>2.2.0</resilience4j.version>
    <jjwt.version>0.12.6</jjwt.version>
    <!-- Spring Boot 4.1 的 BOM 不再管理 Testcontainers，需自行 import 其 BOM -->
    <testcontainers.version>1.21.4</testcontainers.version>
    <maven-compiler-plugin.version>3.13.0</maven-compiler-plugin.version>

    <!-- 与现有 Python wheel 版本逐位一致：同一份 C++ 内核 -->
    <ortools.version>9.15.6755</ortools.version>

    <!--
      Apache POI：导出课表为 xlsx（Python 侧用 openpyxl）。
      Spring Boot 的 BOM 不管理它，所以自己定版本。
      ⚠ 只引 poi-ooxml —— 它已经把 poi（核心）与必要依赖带进来了。
    -->
    <poi.version>5.5.1</poi.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-dependencies</artifactId>
        <version>${spring-boot.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.springframework.cloud</groupId>
        <artifactId>spring-cloud-dependencies</artifactId>
        <version>${spring-cloud.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.springframework.ai</groupId>
        <artifactId>spring-ai-bom</artifactId>
        <version>${spring-ai.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.testcontainers</groupId>
        <artifactId>testcontainers-bom</artifactId>
        <version>${testcontainers.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>

      <!-- 求解内核 -->
      <dependency>
        <groupId>com.google.ortools</groupId>
        <artifactId>ortools-java</artifactId>
        <version>${ortools.version}</version>
      </dependency>

      <!-- 内部模块 -->
      <dependency>
        <groupId>com.orbit</groupId>
        <artifactId>orbit-common</artifactId>
        <version>${project.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <!--
          ⚠ 必须显式绑定 repackage 目标。

          本工程用「BOM 导入」而不是继承 spring-boot-starter-parent，
          因此 starter-parent 里预置的那个 repackage 执行**不会**被继承。
          少了它，mvn package 只会产出一个普通 jar（没有 BOOT-INF/），
          java -jar 会报「没有主清单属性」—— 这个坑只有真的跑起来才会发现。

          放在 pluginManagement 里的好处：只有声明了本插件的模块才会被 repackage。
          库模块（orbit-solver-core）不声明它，因此不会被破坏成不可依赖的 fat jar。
        -->
        <plugin>
          <groupId>org.springframework.boot</groupId>
          <artifactId>spring-boot-maven-plugin</artifactId>
          <version>${spring-boot.version}</version>
          <executions>
            <execution>
              <id>repackage</id>
              <goals>
                <goal>repackage</goal>
              </goals>
            </execution>
          </executions>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>${maven-compiler-plugin.version}</version>
          <configuration>
            <release>${maven.compiler.release}</release>
            <parameters>true</parameters>
          </configuration>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>
</project>
