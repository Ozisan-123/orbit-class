# MySQL (local development only; replace for production)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=orbit_schedule
MYSQL_USER=orbit
MYSQL_PASSWORD=OrbitDev@2026
MYSQL_ROOT_PASSWORD=Root@2026

# Redis
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_REQUIRED=true

# Authentication and bootstrap administrator
APP_SECRET_KEY=replace-with-a-long-random-secret-before-production
TOKEN_TTL_SECONDS=28800
ORBIT_ADMIN_USERNAME=admin
ORBIT_ADMIN_PASSWORD=Admin@123

# Scheduling and worker
MAX_CONCURRENT_SCHEDULES=2
SCHEDULE_SOLVER_WORKERS=2
SCHEDULE_LEASE_SECONDS=300
SCHEDULE_LOCK_SECONDS=300
SCHEDULE_TIME_LIMIT=60
WORKER_CONCURRENCY=1
WORKER_SHARED_SECRET=orbit-dev-worker

# Optional OpenAI-compatible model endpoint
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com
LLM_MODEL=gpt-4o-mini
ASSISTANT_DAILY_TOKEN_BUDGET=200000
